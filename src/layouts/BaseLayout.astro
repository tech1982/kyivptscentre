---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.scss';
import { getLangFromUrl } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: 'uk' | 'en';
  canonicalUrl?: string;
}

const { title, description, canonicalUrl } = Astro.props;
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const fullTitle = `${title} — Київ-PTS-Центр`;
const canonical = canonicalUrl ?? Astro.url.href;
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'uk'} dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonical} />

  <!-- Alternate language links -->
  {lang === 'uk'
    ? <link rel="alternate" hreflang="en" href={Astro.url.href.replace(Astro.site?.origin ?? '', '') === '/' ? '/en/' : `/en${Astro.url.pathname}`} />
    : <link rel="alternate" hreflang="uk" href={Astro.url.pathname.replace(/^\/en/, '') || '/'} />
  }
  <link rel="alternate" hreflang="x-default" href={Astro.url.href} />

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%230a4d68'/><text y='24' x='4' font-size='22' font-family='Arial' fill='white' font-weight='bold'>P</text></svg>" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@700;800&display=swap" rel="stylesheet" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'uk_UA'} />
  <meta property="og:image" content="https://pts-centre.kiev.ua/images/og-cover.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://pts-centre.kiev.ua/images/og-cover.png" />
</head>
<body>
  <a href="#main" class="skip-link">
    {lang === 'en' ? 'Skip to main content' : 'Перейти до основного вмісту'}
  </a>

  <Header lang={lang} currentPath={Astro.url.pathname} />

  <main id="main">
    <slot />
  </main>

  <Footer lang={lang} />

  <button
    class="back-to-top"
    id="backToTop"
    aria-label={lang === 'en' ? 'Back to top' : 'Нагору'}
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M18 15l-6-6-6 6" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <script>
    // Back to top
    const btn = document.getElementById('backToTop');
    if (btn) {
      const toggle = () => btn.classList.toggle('visible', window.scrollY > 400);
      window.addEventListener('scroll', toggle, { passive: true });
      btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      toggle();
    }
  </script>
</body>
</html>
