---
import ProductLayout from '../../../components/ProductLayout.astro';
import SectionTitle from '../../../components/SectionTitle.astro';
import FeatureList from '../../../components/FeatureList.astro';
const nav = [
  { href: '/en/pneumo/',             label: 'Overview' },
  { href: '/en/pneumo/areas/',       label: 'Applications' },
  { href: '/en/pneumo/systems/',     label: 'System types' },
  { href: '/en/pneumo/stations/',    label: 'Station types' },
  { href: '/en/pneumo/equipment/',   label: 'Equipment' },
  { href: '/en/pneumo/accessories/', label: 'Accessories' },
  { href: '/en/pneumo/capsules/',    label: 'Capsules' },
  { href: '/en/pneumo/software/',    label: 'Control software' },
];
const items = [
  'Blowers (compressors) — generate and maintain the airflow',
  'Pipelines 110 mm or 160 mm diameter in stainless steel or plastic',
  'Direction switches — automatically route capsules',
  'Control units — coordinate the operation of all system components',
  'Diagnostic modules — monitor system status and alert on faults',
];
---
<ProductLayout lang="en" title="Pneumatic Tube Equipment" description="Components of pneumatic tube systems: blowers, pipelines, switches, controllers." sidebarLabel="Pneumatic Tube Mail" navItems={nav} breadcrumbs={[{ label: 'Pneumatic Tube Mail', href: '/en/pneumo/' }, { label: 'Equipment' }]} currentPath="/en/pneumo/equipment/">
  <SectionTitle tag="Pneumatic Tube Mail" title="General Equipment" />
  <p style="font-size:.97rem;color:var(--color-text-muted);line-height:1.8;margin-bottom:8px">Beyond the stations, every system includes essential infrastructure components that ensure reliable operation.</p>
  <img src="/images/SSCHS_System.gif" alt="Pneumatic tube system diagram" style="width:100%;border-radius:12px;margin:16px 0" loading="lazy" />
  <FeatureList items={items} />
</ProductLayout>
