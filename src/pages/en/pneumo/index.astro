---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionTitle from '../../../components/SectionTitle.astro';
import FeatureList from '../../../components/FeatureList.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import pneumoData from '../../../content/pages/pneumo.en.json';

const lang = 'en';
const { description, where, advantages } = pneumoData;

const subpages = [
  { href: '/en/pneumo/',             label: 'Overview' },
  { href: '/en/pneumo/areas/',       label: 'Applications' },
  { href: '/en/pneumo/systems/',     label: 'System types' },
  { href: '/en/pneumo/stations/',    label: 'Station types' },
  { href: '/en/pneumo/equipment/',   label: 'Equipment' },
  { href: '/en/pneumo/accessories/', label: 'Accessories' },
  { href: '/en/pneumo/capsules/',    label: 'Capsules' },
  { href: '/en/pneumo/software/',    label: 'Control software' },
];
---

<BaseLayout lang={lang} title="Pneumatic Tube Systems — Sumetzberger" description="Supply and installation of pneumatic tube systems in Ukraine. Manufacturer: Sumetzberger (Austria). Speed up to 8 m/s, range up to 600 m.">
  <div class="container">
    <div class="page-layout">
      <aside>
        <nav class="sidebar-nav">
          <div class="sidebar-nav__label">Pneumatic Tube Mail</div>
          <ul class="sidebar-nav__list">
            {subpages.map(({ href, label }) => (
              <li><a href={href} class:list={['sidebar-nav__link', { active: Astro.url.pathname === href }]}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </aside>
      <article>
        <Breadcrumb homeLabel="Home" homeHref="/en/" items={[{ label: 'Pneumatic Tube Mail' }]} />
        <SectionTitle tag="Pneumatic Tube Mail" title="Pneumatic Tube Transport Systems" subtitle="Reliable, fast delivery of documents and small items within buildings — by Sumetzberger (Austria)." />
        <div class="prose">
          <p>{description}</p>
          <p><strong>Applications:</strong> {where}</p>
        </div>
        <h3 class="subsection-title">Key benefits</h3>
        <FeatureList items={advantages} />
        <div class="partner-note">
          <a href="https://www.sumetzberger.at" target="_blank" rel="noopener noreferrer" class="btn btn--ghost btn--sm">Manufacturer: Sumetzberger GmbH (Austria) ↗</a>
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<style lang="scss">
.prose { p { font-size: 0.97rem; line-height: 1.8; color: var(--color-text-muted); margin-bottom: 16px; strong { color: var(--color-text); } } }
.subsection-title { font-size: 1.1rem; color: var(--color-text); margin: 32px 0 16px; }
.partner-note { margin-top: 32px; }
</style>
