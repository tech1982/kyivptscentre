---
import ProductLayout from '../../../components/ProductLayout.astro';
import SectionTitle from '../../../components/SectionTitle.astro';
import FeatureList from '../../../components/FeatureList.astro';
const nav = [
  { href: '/en/queue/',              label: 'Overview' },
  { href: '/en/queue/areas/',        label: 'Applications' },
  { href: '/en/queue/systems/',      label: 'System types' },
  { href: '/en/queue/registration/', label: 'Client registration' },
  { href: '/en/queue/displays/',     label: 'Information displays' },
  { href: '/en/queue/call/',         label: 'Call buttons' },
  { href: '/en/queue/accessories/',  label: 'Accessories' },
  { href: '/en/queue/software/',     label: 'Control software' },
];
const items = [
  'Service category and priority configuration',
  'Real-time counter load monitoring',
  'Detailed statistical reports for management',
  'CRM/ERP integration via API',
  'Remote management of multiple branches from a single centre',
  'Multi-language interface',
];
---
<ProductLayout lang="en" title="Queue Management Software" description="Software for electronic queue management systems: analytics, reports, integrations." sidebarLabel="Queue Management" navItems={nav} breadcrumbs={[{ label: 'Queue Management', href: '/en/queue/' }, { label: 'Control software' }]} currentPath="/en/queue/software/">
  <SectionTitle tag="Queue Management" title="Control Software" />
  <p style="font-size:.97rem;color:var(--color-text-muted);line-height:1.8;margin-bottom:8px">Full management and analytics cycle — from configuration to detailed management reports.</p>
  <FeatureList items={items} />
</ProductLayout>
