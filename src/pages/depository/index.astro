---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import FeatureList from '../../components/FeatureList.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

import pageData from '../../content/pages/depository.uk.json';
const lang = 'uk';
const { description, offerings } = pageData;
---

<BaseLayout lang={lang} title="Депозитарне обладнання — Robur Safe" description="Постачання та встановлення депозитарного обладнання Robur Safe (Швеція): сейфові двері, сховища, депозитні скриньки.">
  <div class="container">
    <div class="page-layout">
      <aside>
        <nav class="sidebar-nav">
          <div class="sidebar-nav__label">Депозитарій</div>
          <ul class="sidebar-nav__list">
            <li><a href="/depository/" class="sidebar-nav__link active">Огляд</a></li>
          </ul>
        </nav>
      </aside>
      <article>
        <Breadcrumb items={[{ label: 'Депозитарне зберігання' }]} />
        <SectionTitle
          tag="Депозитарій"
          title="Професійне обладнання для зберігання цінностей"
          subtitle="Сейфові двері, сховища та депозитні скриньки від Robur Safe (Швеція)."
        />
        <p class="prose-p">{description}</p>
        <h3 class="subsection-title">Що ми пропонуємо</h3>
        <FeatureList items={offerings} />
        <div style="margin-top:32px;">
          <a href="https://www.robursafe.com" target="_blank" rel="noopener noreferrer" class="btn btn--ghost btn--sm">
            Виробник: Robur Safe (Швеція) ↗
          </a>
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<style lang="scss">
.prose-p { font-size: 0.97rem; line-height: 1.8; color: var(--color-text-muted); margin-bottom: 16px; }
.subsection-title { font-size: 1.1rem; color: var(--color-text); margin: 32px 0 16px; }
</style>
