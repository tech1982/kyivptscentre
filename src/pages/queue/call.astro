---
import ProductLayout from '../../components/ProductLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import FeatureList from '../../components/FeatureList.astro';
const nav = [
  { href: '/queue/',              label: 'Огляд' },
  { href: '/queue/areas/',        label: 'Сфери застосування' },
  { href: '/queue/systems/',      label: 'Типи систем' },
  { href: '/queue/registration/', label: 'Реєстрація клієнтів' },
  { href: '/queue/displays/',     label: 'Інформаційні табло' },
  { href: '/queue/call/',         label: 'Кнопковий виклик' },
  { href: '/queue/accessories/',  label: 'Аксесуари' },
  { href: '/queue/software/',     label: 'ПЗ керування' },
];
const items = [
  'Апаратна кнопкова панель: Наступний, Повтор, Пауза — простий і надійний інтерфейс',
  'Програмний інтерфейс на ПК оператора з розширеними функціями керування',
  'Переадресація клієнта до іншого вікна без втрати місця в черзі',
  'Індикація кількості клієнтів, що очікують, на екрані оператора',
  'Автоматичний режим «Вікно закрите» при відсутності оператора',
];
---
<ProductLayout lang="uk" title="Кнопковий виклик QMS" description="Пристрої виклику для операторів систем керування чергою." sidebarLabel="Керування чергою" navItems={nav} breadcrumbs={[{ label: 'Керування чергою', href: '/queue/' }, { label: 'Кнопковий виклик' }]} currentPath="/queue/call/">
  <SectionTitle tag="Керування чергою" title="Кнопковий виклик" />
  <p style="font-size:.97rem;color:var(--color-text-muted);line-height:1.8;margin-bottom:8px">Пристрої виклику на робочому місці оператора — зручний інструмент для управління потоком клієнтів.</p>
  <FeatureList items={items} />
</ProductLayout>
