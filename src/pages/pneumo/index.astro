---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import FeatureList from '../../components/FeatureList.astro';
import ItemGrid from '../../components/ItemGrid.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import pneumoData from '../../content/pages/pneumo.uk.json';

const lang = 'uk';
const { description, where, advantages } = pneumoData;

const subpages = [
  { href: '/pneumo/',             label: 'Огляд' },
  { href: '/pneumo/areas/',       label: 'Сфери застосування' },
  { href: '/pneumo/systems/',     label: 'Типи систем' },
  { href: '/pneumo/stations/',    label: 'Типи станцій' },
  { href: '/pneumo/equipment/',   label: 'Обладнання' },
  { href: '/pneumo/accessories/', label: 'Аксесуари' },
  { href: '/pneumo/capsules/',    label: 'Капсули' },
  { href: '/pneumo/software/',    label: 'ПЗ керування' },
];
---

<BaseLayout
  lang={lang}
  title="Системи пневматичної пошти — Sumetzberger"
  description="Постачання та монтаж систем пневматичної пошти в Україні. Виробник Sumetzberger (Австрія). Швидкість до 8 м/с, дальність до 600 м."
>
  <div class="container">
    <div class="page-layout">
      <!-- Sidebar -->
      <aside>
        <nav class="sidebar-nav" aria-label="Розділи пневмопошти">
          <div class="sidebar-nav__label">Пневматична пошта</div>
          <ul class="sidebar-nav__list">
            {subpages.map(({ href, label }) => (
              <li>
                <a href={href} class:list={['sidebar-nav__link', { active: Astro.url.pathname === href }]}>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <!-- Content -->
      <article>
        <Breadcrumb items={[{ label: 'Пневматична пошта' }]} />

        <SectionTitle
          tag="Пневматична пошта"
          title="Системи пневматичного транспорту"
          subtitle="Надійна та швидка доставка документів і дрібних вантажів усередині будівель — від виробника Sumetzberger (Австрія)."
        />

        <div class="prose">
          <p>{description}</p>
          <p><strong>Де застосовується:</strong> {where}</p>
        </div>

        <div class="pneumo-photos">
          <img src="/images/BankCashArea.jpg" alt="Касова зона банку з пневмопоштою" loading="lazy" />
          <img src="/images/TellerPlace.jpg"  alt="Робоче місце касира" loading="lazy" />
        </div>

        <h3 class="subsection-title">Основні переваги</h3>
        <FeatureList items={advantages} />

        <div class="partner-note">
          <a href="https://www.sumetzberger.at" target="_blank" rel="noopener noreferrer" class="btn btn--ghost btn--sm">
            Виробник: Sumetzberger GmbH (Австрія) ↗
          </a>
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<style lang="scss">
.prose { p { font-size: 0.97rem; line-height: 1.8; color: var(--color-text-muted); margin-bottom: 16px; strong { color: var(--color-text); } } }
.subsection-title { font-size: 1.1rem; color: var(--color-text); margin: 32px 0 16px; }
.partner-note { margin-top: 32px; }
.pneumo-photos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin: 24px 0;
  img { width: 100%; height: 180px; object-fit: cover; border-radius: var(--radius-md); }
  @media (max-width: 480px) { grid-template-columns: 1fr; }
}
</style>
